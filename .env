# Server Port (default: 5001)
PORT=5001
NODE_ENV=development

# Database Configuration (blank = embedded in-memory MongoDB)
MONGODB_URI=

# Security & Authentication
JWT_SECRET=agrovoice_dev_super_secret_jwt_key_2026_change_in_production!
JWT_EXPIRES_IN=7d

# Client Origin (CORS whitelist)
CLIENT_ORIGIN=http://localhost:5173

# Telephony Mode: "test" (simulated calls with DTMF keypad simulator) or "real" (Exotel outbound calls)
TELEPHONY_MODE=test

# Exotel Credentials (optional in test mode)
EXOTEL_ACCOUNT_SID=test_sid
EXOTEL_API_KEY=test_key
EXOTEL_API_TOKEN=test_token
EXOTEL_CALLER_ID=08047100000
EXOTEL_SUBDOMAIN=api.exotel.com

# Webhook Configuration
WEBHOOK_BASE_URL=http://localhost:5001
WEBHOOK_SHARED_SECRET=agrovoice_webhook_secret_key_tn_2026

# Optional AI Voice Advisory Script Generation (Gemini)
GEMINI_API_KEY=

# Text-to-Speech Provider (optional, "mock" or "google")
TTS_PROVIDER=mock

# Background Weather Monitoring Cron
WEATHER_CRON=*/30 * * * *

# Telephony Rate Limiting & Queue Tuning
CALLS_PER_SECOND=2
MAX_CALL_RETRIES=2

# Client Demo Mode
VITE_DEMO_MODE=true
