# =====================================================
# AgroVoice AI - Environment Configuration
# =====================================================

# Server Port (default: 5001)
PORT=5001
NODE_ENV=development

# Database Configuration
# Leave blank to automatically use zero-config embedded in-memory MongoDB (mongodb-memory-server)
# Example for MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/agrovoice?retryWrites=true&w=majority
MONGODB_URI=

# Security & Authentication
JWT_SECRET=agrovoice_dev_super_secret_jwt_key_2026_change_in_production!
JWT_EXPIRES_IN=7d

# Client Origin (CORS whitelist)
CLIENT_ORIGIN=http://localhost:5173

# Telephony Mode: "test" (simulated calls with DTMF keypad simulator) or "real" (Exotel outbound calls)
TELEPHONY_MODE=test

# Exotel Credentials (required ONLY when TELEPHONY_MODE=real)
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=08047100000
EXOTEL_SUBDOMAIN=api.exotel.com

# Webhook Configuration
# In development with real Exotel, point to your ngrok tunnel: https://xxxx.ngrok-free.app
# Backend port is 5001 (ngrok http 5001)
WEBHOOK_BASE_URL=http://localhost:5001
WEBHOOK_SHARED_SECRET=agrovoice_webhook_secret_key_tn_2026

# Optional AI Voice Advisory Script Generation (Gemini)
# If blank, deterministic colloquial Tamil & English templates are used automatically
GEMINI_API_KEY=

# Text-to-Speech Provider (optional, "mock" or "google")
# If mock, high quality audio waveform playback is synthesized and served for ExoML <Play>
TTS_PROVIDER=mock
GOOGLE_TTS_API_KEY=

# Background Weather Monitoring Cron
# Default: every 30 minutes ("*/30 * * * *") or every 10 minutes ("*/10 * * * *")
WEATHER_CRON=*/30 * * * *

# Telephony Rate Limiting & Queue Tuning
CALLS_PER_SECOND=2
MAX_CALL_RETRIES=2

# Client Demo Mode (enables Hackathon 1-click credentials on login page)
VITE_DEMO_MODE=true
